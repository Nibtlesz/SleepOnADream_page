# Copia este archivo a .env.local y completa los valores. Nunca subas .env* al repositorio.

# URL pública del sitio (sin barra final)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# PostgreSQL. Sin DATABASE_URL el sitio usa datos de ejemplo en memoria.
DATABASE_URL="postgresql://USUARIO:CONTRASEÑA@localhost:5432/sleeponadream?schema=public"
# Conexiones por proceso en ejecución (10 por defecto; al compilar siempre se usa 1).
# En serverless conviene 1–5 (o un pooler como PgBouncer / Prisma Postgres).
DATABASE_POOL_MAX="10"

# Administrador inicial que crea `npm run db:seed` (solo si no existe). Mínimo 12 caracteres.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Mercado Pago — Tus integraciones > Credenciales. Usa las de PRUEBA hasta salir a producción.
MERCADOPAGO_ACCESS_TOKEN=""
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=""
# Tus integraciones > Webhooks > clave secreta (evento "Pagos", URL: https://TU-DOMINIO/api/webhooks/mercadopago)
MERCADOPAGO_WEBHOOK_SECRET=""

# Correo transaccional (Fase 5)
EMAIL_API_KEY=""
EMAIL_FROM="Sleep On a Dream <no-reply@dominio-por-definir.mx>"

# Almacenamiento de imágenes (Fase 4)
STORAGE_BUCKET=""
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# Activa los pagos reales: "mercadopago" (vacío = solo pago de prueba en desarrollo)
PAYMENT_PROVIDER=""

# Protege las tareas programadas /api/cron/* (pedidos vencidos y sincronización de Bandsintown)
CRON_SECRET=""

# Bandsintown: conciertos automáticos. Clave en Bandsintown for Artists → Settings → General → Get API Key.
BANDSINTOWN_APP_ID=""
# Nombre del artista en Bandsintown (o "id_123456" con su ID).
BANDSINTOWN_ARTIST="Sleep On A Dream"
