# Copia este archivo a .env.local y completa los valores. Nunca subas .env* al repositorio.

# URL pública del sitio (sin barra final)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# PostgreSQL (Fase 4)
DATABASE_URL="postgresql://USUARIO:CONTRASEÑA@localhost:5432/sleeponadream?schema=public"

# Auth.js (Fase 4) — genera con: npx auth secret
AUTH_SECRET=""

# Pagos (Fase 5) — usar claves de PRUEBA hasta salir a producción
MERCADOPAGO_ACCESS_TOKEN=""
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=""
MERCADOPAGO_WEBHOOK_SECRET=""
# STRIPE_SECRET_KEY=""
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# STRIPE_WEBHOOK_SECRET=""

# Correo transaccional (Fase 5)
EMAIL_API_KEY=""
EMAIL_FROM="Sleep On a Dream <no-reply@dominio-por-definir.mx>"

# Almacenamiento de imágenes (Fase 4)
STORAGE_BUCKET=""
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# Proveedor de pagos activo: "mercadopago" o "stripe" (vacío = solo pago de prueba en desarrollo)
PAYMENT_PROVIDER=""

# Protege /api/cron/expire-orders (libera inventario de pedidos no pagados)
CRON_SECRET=""
